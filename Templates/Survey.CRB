'{{ station_name }} {{ model_series }}
'Created with Jinja2 from bear_valley_cr_basic

'Constants
Const SITE_LOCATION_PRESSURE=74.11727
Const SR50A_Minimum_Depth=14 'Minimum depth for SR50A-M Snow Depth measurement in inches
Const SR50A_Maximum_Quality=250 'Readings with a higher quality number (weaker echo) are discarded
Const SR50A_Sort_Filler=1E9 'Distance given to unused readings while sorting so they sort last (NAN breaks the sort)

'Functions

{% include find_template("Functions/WetBulb_Function.CRB") %}

{% include find_template("Functions/DewPoint_Function.CRB") %}

{% include find_template("Functions/WindChill_Function.CRB") %}

{% if enable_precip_and_snow_sensors %}
{% include find_template("Functions/SR50A_TempCorrect_Function.CRB") %}

{% include find_template("Functions/SR50A_SnowDepth_Function.CRB") %}
{% endif %}

'Declare Variables and Units
{% include find_template("Air_Temperature_Vars.CRB") %}

{% include find_template("Windspeed_Vars.CRB") %}


Public BattV: Units BattV=Volts
Public ProgStartEpoch As Long : Units ProgStartEpoch=seconds
{% if model_series == "CR6" %}
Public ChargeInput : Units ChargeInput=Volts
Public ChargeState As String * 24
{% endif %}

Dim PTemp_C
{% if sensor_cabinet_temperature["disabled"] != True %}
Dim Temp_F
{% endif %}


{% if enable_precip_and_snow_sensors %}
Dim StartupTime(9)

{% with sensor_index=1 %}
{% include "Include/SR50A_M/SR50A_M_Vars.CRB" %}

{% endwith %}
{% with sensor_index=2 %}
{% include "Include/SR50A_M/SR50A_M_Vars.CRB" %}

Dim Rain_in : Units Rain_in=inch
Public BaroVUE(3)

Alias BaroVUE(1)=BaroV_BP : Units BaroV_BP=inHg
Alias BaroVUE(2)=BaroV_Temp : Units BaroV_Temp=deg F
Alias BaroVUE(3)=BaroV_Qual : Units BaroV_Qual=unitless
{% endwith %}
{% endif %}

{% if power_control and power_control["enabled"] %}
{% include find_template("Power_Control_Vars.CRB") %}

{% endif %}
{% include find_template("Watchdog_Vars.CRB") %}

'Define Data Tables
{% for table in legacy_tables %}
{% include table["file"] %}


{% endfor %}
{% include "Include/Tables/TG_15S_Wind.CRB" %}

{% include "Include/Tables/TG_5Min_Temp.CRB" %}

{% if enable_precip_and_snow_sensors %}
{% include "Include/Tables/TG_15M_Precip.CRB" %}

{% endif %}
{% if include_mesowest | default(True) %}
{% include "Include/Tables/MW_15M.CRB" %}
{% endif %}

{% include "Include/Tables/Table10Min.CRB" %}

{% include "Include/Tables/Table60Min.CRB" %}

{% include "Include/Tables/StationDaily.CRB" %}


'Main Program
BeginProg
	'Record program start time (epoch seconds) for uptime calculation
	ProgStartEpoch = Status.Timestamp(0,1)
	{% if enable_precip_and_snow_sensors %}
	'Default snow depth to disabled for the off-season (June - October) based
	'on the RTC date at boot. 2026 is forced on (the season started early).
	'RealTime() array: (1)Year (2)Month (3)Day (4)Hour (5)Min (6)Sec (7)uSec (8)DOW (9)DOY
	RealTime(StartupTime)
	If StartupTime(1)<>2026 AND StartupTime(2)>=6 AND StartupTime(2)<=10 Then
		SR50A_1_DisableSnowDepth = True
		SR50A_2_DisableSnowDepth = True
	Else
		SR50A_1_DisableSnowDepth = False
		SR50A_2_DisableSnowDepth = False
	EndIf
	'No data until the first burst of readings completes.
	SR50A_1_Attempt = 0
	SR50A_1_Valid = 0
	SR50A_2_Attempt = 0
	SR50A_2_Valid = 0
	SR50A_1_Valid_Count = 0
	SR50A_2_Valid_Count = 0
	Move(SR50A_1_Raw(1,1),33,NAN,1)
	Move(SR50A_2_Raw(1,1),33,NAN,1)
	SR50A_1_TCDT = NAN
	SR50A_2_TCDT = NAN
	SR50A_1_Q = NAN
	SR50A_2_Q = NAN
	SR50A_1_Snow_Depth = NAN
	SR50A_2_Snow_Depth = NAN
	SR50A_1_Initial_Depth = {{ sr50a_initial_depth[0] }}
	SR50A_2_Initial_Depth = {{ sr50a_initial_depth[1] }}
	SR50A_1_Ctrl = True
	SR50A_2_Ctrl = True
	{% endif %}
	'Main Scan
	Scan({{ main_scan_interval_count }},{{ main_scan_interval_unit }},1,0)
		{% include find_template("Watchdog_Scan.CRB") %}
		{% if power_control and power_control["enabled"] %}
		{% include find_template("Power_Control_Scan.CRB") %}
		{% endif %}
		{% include find_template("Windspeed_Scan.CRB") %}

		{% if enable_precip_and_snow_sensors %}
		'Generic Tipping Bucket Rain Gauge measurement 'Rain_in'
		PulseCount(Rain_in,1,U3,1,0,0.01,0)
		{% endif %}

		'Call Data Tables and Store Data
		{% for table in legacy_tables %}
		CallTable {{ table["name"] }}
		{% endfor %}
		CallTable TG_15S_Wind
		CallTable TG_5Min_Temp
		{% if enable_precip_and_snow_sensors %}
		CallTable TG_15M_Precip

		{% endif %}
		{% if include_mesowest | default(True) %}
		CallTable MW_15M
		{% endif %}
		CallTable Table10Min
		CallTable Table60Min
		CallTable StationDaily
	NextScan

	
{% if enable_precip_and_snow_sensors %}
SlowSequence
	Scan(10,Sec,1,0)
		{% with sensor_index=1 %}
		{% include "Include/SR50A_M/SR50A_M_Sample.CRB" %}
		{% endwith %}


		{% with sensor_index=2 %}
		{% include "Include/SR50A_M/SR50A_M_Sample.CRB" %}
		{% endwith %}

	NextScan
{% endif %}


SlowSequence
	'Non-Wind Scan
	Scan(60,Sec,1,0)
		'Default {{ model_series }} Datalogger Battery Voltage measurement 'BattV'
		Battery(BattV)
		'Default {{ model_series }} Datalogger Wiring Panel Temperature measurement 'PTemp_C'
		PanelTemp(PTemp_C,{{ panel_frequency_filter }})
		{% if model_series == "CR6" %}
		'CR6 charger input voltage and charge state (from Status table)
		ChargeInput = Status.ChargeInput(1,1)
		ChargeState = Status.ChargeState(1,1)
		{% endif %}
		
		{% include find_template("Cabinet_Temperature_Scan.CRB") %}

		{% include find_template("Air_Temperature_Scan.CRB") %}

{% if enable_precip_and_snow_sensors %}
		{% include "Include/Barometric/BaroSlowScan.CRB" %}
{% endif %}

	NextScan

{% include find_template("Watchdog_PingScan.CRB") %}

EndProg
