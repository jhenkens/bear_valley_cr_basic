
DataTable(TG_15M_Precip,True,2880)
	DataInterval(0,15,Min,10)

	Totalize(1,Rain_in,FP2,False)
	FieldNames("Precip")
	Sample(1,SR50A_1_Snow_Depth,FP2)
	FieldNames("IntSnow")
	Sample(1,SR50A_1_TCDT,FP2)
	FieldNames("IntDist")
	Sample(1,SR50A_1_Q,FP2)
	FieldNames("IntQ")
	Sample(1,SR50A_1_Valid_Count,FP2)
	FieldNames("IntValid")
	Sample(1,SR50A_2_Snow_Depth,FP2)
	FieldNames("TtlSnow")
	Sample(1,SR50A_2_TCDT,FP2)
	FieldNames("TtlDist")
	Sample(1,SR50A_2_Q,FP2)
	FieldNames("TtlQ")
	Sample(1,SR50A_2_Valid_Count,FP2)
	FieldNames("TtlValid")

	Sample(1,BaroV_BP,IEEE4)
	FieldNames("BarometricPressure")
	
	Sample(1,SR50A_1_DisableSnowDepth,Boolean)
	FieldNames("IntSnowDisabled")
	Sample(1,SR50A_2_DisableSnowDepth,Boolean)
	FieldNames("TtlSnowDisabled")
EndTable
